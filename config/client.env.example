# Copy to ~/.config/tunnel/config and chmod 600.
# This file contains routing metadata only; keep the token in a separate file.
# The control address must be a private/VPN IP. For Tailscale, use the server's
# 100.64.0.0/10 address (or its fd7a:115c:a1e0::/48 IPv6 address).

TUNNEL_SERVER_ADDR=100.64.0.10
TUNNEL_SERVER_PORT=7000
TUNNEL_BASE_DOMAIN=tunnel.example.com
# Exact lowercase labels permitted by the server and Nginx.
TUNNEL_ALLOWED_DOMAINS=app,docs,staging
