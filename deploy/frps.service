[Unit]
Description=Portspan frp tunnel server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frps
Group=frps
WorkingDirectory=/var/lib/frp
ExecStart=/usr/local/libexec/frp/frps -c /etc/frp/frps.toml
Restart=on-failure
RestartSec=5s
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/frp

[Install]
WantedBy=multi-user.target

