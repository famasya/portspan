# Copy to /etc/tunnel/tunnel.env with mode 600 or stricter.
# Values must be simple KEY=value entries with no shell metacharacters.
TUNNEL_BASE_DOMAIN=tunnel.example.com
# Exact lowercase labels permitted at the public Nginx boundary.
TUNNEL_ALLOWED_DOMAINS=app,docs,staging

# Self-signed private-CA certificate lifecycle. Distribute only the .crt CA
# certificate to clients that should trust Portspan; never distribute the CA key.
TUNNEL_CERT_DAYS=30
TUNNEL_CERT_RENEW_DAYS=15

# The frp control channel must stay on the private/VPN network.
TUNNEL_CONTROL_BIND_ADDR=100.64.0.10
TUNNEL_CONTROL_ALLOW_FROM=100.64.0.0/10
